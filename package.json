{
	"name": "messenger-api",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"imports": {
		"#*": "./src/*"
	},
	"scripts": {
		"build": "tsc",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio --port=3900 --verbose",
		"dev": "node --watch src/index.ts",
		"lint": "biome check --fix --reporter=concise",
		"start": "node src/index.ts",
		"test": "vitest"
	},
	"dependencies": {
		"@better-auth/drizzle-adapter": "^1.7.5",
		"@hono/node-server": "^2.1.1",
		"@hono/standard-validator": "^0.4.0",
		"@supabase/storage-js": "^2.116.0",
		"better-auth": "^1.7.5",
		"drizzle-orm": "1.0.0-rc.4",
		"hono": "^4.13.8",
		"postgres": "^3.4.9",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@types/node": "^26.6.1",
		"drizzle-kit": "1.0.0-rc.4",
		"typescript": "^7.0.2",
		"vitest": "^5.0.1"
	},
	"packageManager": "pnpm@12.4.2",
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.4.2",
			"onFail": "download"
		}
	}
}
